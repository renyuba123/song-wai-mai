#!/usr/bin/env sh
set -u

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
if [ "$branch" = "main" ]; then
    echo "Direct commits to main are blocked." >&2
    echo "Create a short-lived branch first, for example:" >&2
    echo "  git switch -c feature/<github-id>-<topic>" >&2
    exit 1
fi
